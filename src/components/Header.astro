---
import "@styles/global.css"
import { Icon } from "astro-icon/components"
import { profileConfig, siteConfig } from "@/config"
import ThemeIcon from "./control/ThemeIcon.astro"
import { baseUrl } from "@utils/url-utils"

import { i18n } from "astro:config/client";
import i18nit from '@i18n/translation'
import { getRelativeLocaleUrl } from '@utils/url-utils';
import { getBlogEntrySort } from '@utils/content-utils';

const currentLang = Astro.currentLocale || i18n!.defaultLocale;
const t = i18nit(currentLang);
const showLanguageSwitcher = (i18n?.locales?.length ?? 0) > 1;

// 收集所有文章分类（含未分类），按名称排序，用于移动端侧边栏
const blogPosts = await getBlogEntrySort(currentLang);
const categories = [...new Set(blogPosts.map(post => post.data.category || 'undefined'))].sort();


// 获取当前页面在不同语言下的路径
const getLocalePath = (path: string, targetLocale: string) => {
  const currentPath = Astro.url.pathname;
  const defaultLocale = i18n?.defaultLocale || "zh-cn";

  const basePathPrefix = import.meta.env.BASE_URL.replace(/\/+$/, "");
  let basePath = currentPath.startsWith(basePathPrefix)
    ? currentPath.slice(basePathPrefix.length) || "/"
    : currentPath;

  if (!basePath.startsWith("/")) basePath = `/${basePath}`;
  if (currentLang && currentLang !== defaultLocale) {
    basePath = basePath.replace(new RegExp(`^/${currentLang}(?=/|$)`), "") || "/";
  }

  return getRelativeLocaleUrl(targetLocale, basePath);
};

const indexPage = getRelativeLocaleUrl(currentLang, "/");
const archivesPage = getRelativeLocaleUrl(currentLang, "/archives/");
const friendsPage = getRelativeLocaleUrl(currentLang, "/friends/");
const aboutPage = getRelativeLocaleUrl(currentLang, "/about/");

let introPage : string;

if (profileConfig.indexPage) {
    introPage = profileConfig.indexPage;
} else {
    introPage = import.meta.env.BASE_URL;
}
---

<!-- header -->
<div id="main-header" class="fixed top-0 left-0 right-0 z-50 transition-transform duration-300 ease-in-out md:relative md:translate-y-0">
<div class="flex items-center pt-2 md:py-4 text-[var(--text-color)] max-w-[var(--header-width)] mx-auto">
    <!-- logo -->
    <div class="pr-4 py-2 z-30 header-logo">
        <a href={ indexPage } >
            <img src={baseUrl(profileConfig.avatar)} alt={profileConfig.name} class="inline-block w-9 h-9 mr-2 object-cover align-middle" />
            <span class="text-3xl font-bold hover:opacity-60 transition-opacity">{ siteConfig.title }</span>
        </a>
    </div>
    
    <!-- tools -->
    <div class="ml-auto flex gap-2 pl-4 py-2 justify-end z-30">
        <!-- Search -->
        <button id="search-button" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300" aria-label="Search">
            <Icon name="fa6-solid:magnifying-glass" class="w-4 h-4" />
        </button>
        <!-- Dark Mode -->
        <ThemeIcon class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] rounded-lg hover:text-current active:scale-90 border border-[var(--button-border-color)] transition-all duration-300"/>
        <!-- RSS -->
        <!-- <a href="/rss.xml" target="_blank" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300">
            <Icon name="simple-icons:rss" class="w-4 h-4" />
        </a> -->
        <!-- Language Switcher -->
        {showLanguageSwitcher && <div class="relative">
            <button id="language-button" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300" aria-label="Language Switcher">
                <Icon name="fa6-solid:globe" class="w-4 h-4" />
            </button>
            
          <div id="language-menu" class="hidden absolute right-0 mt-2 w-30 bg-[var(--bg-color)] border border-[var(--button-border-color)] rounded-lg shadow-lg z-50">
              <div class="py-1 text-right">
                  <a href={getLocalePath("/", "zh-cn")} class={`block mx-2 my-1 p-2 text-sm rounded ${
                    currentLang === "zh-cn" ? "bg-[var(--button-hover-color)]" : "hover:bg-[var(--button-hover-color)]"}`}>
                    {currentLang === "zh-cn" ? <Icon name="fa6-solid:circle" class="w-2 h-2 inline mr-2" /> : ""}
                    简体中文
                  </a>
                  <a href={getLocalePath("/", "en")} class={`block mx-2 my-1 p-2 text-sm rounded ${
                    currentLang === "en" ? "bg-[var(--button-hover-color)]" : "hover:bg-[var(--button-hover-color)]"}`}>
                    {currentLang === "en" ? <Icon name="fa6-solid:circle" class="w-2 h-2 inline mr-2" /> : ""}
                    English
                  </a>
              </div>
          </div>
        </div>}
        <div class="relative md:hidden">
          <!-- Mobile Menu -->
          <button id="mobile-menu-button" class="flex items-center justify-center w-10 h-10 hover:bg-[var(--button-hover-color)] active:scale-90 rounded-lg hover:text-current border border-[var(--button-border-color)] transition-all duration-300" aria-label="Mobile Menu">
              <Icon name="fa6-solid:align-justify" class="w-5 h-5" />
          </button>
              
        </div>
    </div>
</div>
</div>

    <!-- nav_bar -->
    <div id="nav-bar" class="hidden md:flex absolute left-1/2 top-0 transform -translate-x-1/2  justify-center items-center text-lg font-bold my-5 z-100">
        <div id="nav-bar-list" class="transition relative z-10 flex max-w-max flex-1 items-center justify-center rounded-outer p-2 backdrop-blur rounded-xl bg-[color:var(--bg-color)]/20 border border-[var(--bg-color)]">
          <!-- 首页链接 -->
          <a href={ indexPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === indexPage 
                  ? 'bg-[var(--button-hover-color)]' 
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.home")}
          </a>
          <!-- 归档链接 -->
          <a href={ archivesPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === archivesPage 
                  ? 'bg-[var(--button-hover-color)]' 
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.archive")}
          </a>
          <!-- 关于链接 -->
          <a href={ aboutPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === aboutPage 
                  ? 'bg-[var(--button-hover-color)]' 
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.about")}
          </a>
          <!-- 友链链接 -->
          <a href={ friendsPage } class={`transition-colors rounded-lg px-3 py-1 mx-1 hover:text-current ${
              Astro.url.pathname === friendsPage 
                  ? 'bg-[var(--button-hover-color)]' 
                  : 'hover:bg-[var(--button-hover-color)]'
              }`}>
              {t("header.friends")}
          </a>
        </div>
    </div>
<!-- Mobile Menu -->
<div id="mobile-menu-container" class="fixed inset-0 z-[100] hidden">
    <div id="mobile-menu-overlay" class="absolute inset-0 bg-black/60 backdrop-blur-sm opacity-0 transition-opacity duration-300 ease-in-out"></div>
    
    <div id="mobile-menu-drawer" class="absolute top-0 left-0 bottom-0 w-[70%] max-w-[300px] bg-[var(--bg-color)] shadow-2xl transform -translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        
        <div class="flex items-center justify-between p-5 border-b border-[var(--button-border-color)]">
            <span class="text-xl font-bold header-logo">{ siteConfig.title }</span>
            <button id="mobile-menu-close" class="w-10 h-10 flex items-center justify-center rounded-lg hover:bg-[var(--button-hover-color)] transition-colors">
                <Icon name="fa6-solid:xmark" class="w-5 h-5" />
            </button>
        </div>

        <nav class="flex flex-col py-4 px-2">
            <a href={ indexPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:house" class="w-4 h-4 opacity-70" />
                <span>{t("header.home")}</span>
            </a>
            <a href={ archivesPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:book-bookmark" class="w-4 h-4 opacity-70" />
                <span>{t("header.archive")}</span>
            </a>
            <a href={ aboutPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:user" class="w-4 h-4 opacity-70" />
                <span>{t("header.about")}</span>
            </a>
            <a href={ friendsPage } class="flex items-center gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] hover:text-[var(--link-color)] transition-colors active:bg-[var(--button-hover-color)] active:text-[var(--link-color)]">
                <Icon name="fa6-solid:link" class="w-4 h-4 opacity-70" />
                <span>{t("header.friends")}</span>
            </a>
        </nav>

        <!-- 分类栏：可点击收起，与默认链接之间用横线分割 -->
        {categories.length > 0 && (
        <div class="mt-2">
        <div class="w-[90%] mx-auto border-t border-[var(--button-border-color)]"></div>
        <div class="px-2 pt-1 pb-3">
            <button id="mobile-category-toggle" aria-expanded="false" class="w-full flex items-center justify-between gap-3 px-4 py-3 rounded-lg hover:bg-[var(--button-hover-color)] transition-colors">
                <span class="flex items-center gap-3 text-[var(--text-color)]">
                    <Icon name="fa6-solid:tags" class="w-4 h-4 opacity-70" />
                    <span>{t("category")}</span>
                </span>
                <Icon id="mobile-category-chevron" name="fa6-solid:chevron-down" class="w-4 h-4 opacity-70 transition-transform duration-300" />
            </button>

            <div id="mobile-category-list" class="overflow-hidden transition-[max-height] duration-300 ease-in-out" style="max-height: 0px">
                <ul class="flex flex-wrap gap-2 px-3 pt-3 pb-1">
                    {categories.map(cat => (
                        <li>
                            <a href={getRelativeLocaleUrl(currentLang, `/archives/?category=${encodeURIComponent(cat)}`)} class="inline-flex items-center px-3 py-1.5 text-sm rounded-md border border-[var(--button-border-color)] text-[var(--text-color)] transition-all duration-200 hover:border-[var(--link-color)] hover:bg-[var(--button-hover-color)] active:bg-[var(--button-hover-color)] active:text-[var(--link-color)] active:scale-95">
                                {cat === 'undefined' ? t("pagecard.uncategorized") : cat}
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </div>
        </div>
        )}

        <div class="mt-auto p-5 border-t border-[var(--button-border-color)] flex gap-1 text-sm opacity-70">
             <!-- <a href={getLocalePath("/", "zh-cn")} class="text-sm opacity-70 active:text-[var(--link-color)]">简体中文</a>
             <a href={getLocalePath("/", "en")} class="text-sm opacity-70 active:text-[var(--link-color)]">English</a> -->
             © {profileConfig.startYear} - {new Date().getFullYear()} <a class="link-line" target="_self" href={introPage}>{profileConfig.name}</a>.
        </div>
    </div>
</div>

<style is:global>
.header-logo {
  font-family: "EB Garamond", cursive;
  letter-spacing: 1px;
}
  /* 移动端 (小于 776px) 的毛玻璃和阴影 */
  @media (max-width: 775px) {
    #main-header {
      /* 半透明主题背景 + blur 实现毛玻璃。*/
      background-color: color-mix(in srgb, var(--bg-color) 40%, transparent);
      /* 注意：构建时的 CSS 压缩器会把 backdrop-filter 与 -webkit-backdrop-filter 当作同一属性合并，
         只保留后写的那一条。因此标准属性必须单独放进 @supports 规则里，否则构建后会被删掉，
         导致 Firefox 等只支持标准属性的浏览器在 preview 里失去毛玻璃效果。 */
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid color-mix(in srgb, var(--button-border-color) 10%, transparent);
    }
    @supports (backdrop-filter: blur(1px)) {
      #main-header {
        backdrop-filter: blur(12px);
      }
    }
  }

  /* 当手指上滑时，JS 会给这个 ID 添加该类来隐藏 Header */
  .header-hidden {
    transform: translateY(-100%);
  }
</style>

<script>
function initMobileNav() {
  const menuButton = document.getElementById('mobile-menu-button');
  const closeButton = document.getElementById('mobile-menu-close');
  const container = document.getElementById('mobile-menu-container');
  const overlay = document.getElementById('mobile-menu-overlay');
  const drawer = document.getElementById('mobile-menu-drawer');
  const navBar = document.getElementById('nav-bar');
  const navBarList = document.getElementById('nav-bar-list');

  if (!menuButton || !container) return;

  function openMenu() {
    container?.classList.remove('hidden');
    // 强制重绘以触发动画
    requestAnimationFrame(() => {
      overlay?.classList.add('opacity-100');
      drawer?.classList.remove('-translate-x-full');
    });
    document.body.style.overflow = 'hidden'; // 禁止页面滚动
  }

  function closeMenu() {
    overlay?.classList.remove('opacity-100');
    drawer?.classList.add('-translate-x-full');
    
    // 等待动画结束后隐藏容器
    setTimeout(() => {
      container?.classList.add('hidden');
      document.body.style.overflow = '';
    }, 300);
  }

  menuButton.addEventListener('click', openMenu);
  closeButton?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);

  // 监听导航点击（点击后自动关闭）
  drawer?.querySelectorAll('a').forEach(link => {
    link.addEventListener('click', closeMenu);
  });

  let isFixed = false;
  window.addEventListener('scroll', () => {
    if (window.scrollY > 0 && !isFixed && navBar && navBarList) {
      navBar.classList.add('fixed');
      navBar.classList.remove('border-[var(--bg-color)]');
      navBarList.classList.add(
        'border-[var(--button-border-color)]',
        'shadow-[0_4px_12px_var(--shadow-color)]'
      );
      isFixed = true;
    } else if (window.scrollY === 0 && isFixed && navBar && navBarList) {
      navBar.classList.remove('fixed');
      navBar.classList.add('border-[var(--bg-color)]');
      navBarList.classList.remove(
        'border-[var(--button-border-color)]',
        'shadow-[0_4px_12px_var(--shadow-color)]'
      );
      isFixed = false;
    }
  });
}

document.addEventListener('DOMContentLoaded', initMobileNav);
document.addEventListener('astro:page-load', initMobileNav);
</script>
<script>
function initCategoryAccordion() {
  const toggle = document.getElementById('mobile-category-toggle');
  const list = document.getElementById('mobile-category-list');
  const chevron = document.getElementById('mobile-category-chevron');

  if (!toggle || !list) return;
  if (toggle.dataset.bound === 'true') return;
  toggle.dataset.bound = 'true';

  toggle.addEventListener('click', () => {
    // 用 max-height 过渡实现收起/展开，避免 grid-template-rows 过渡导致的反复重排卡顿
    const collapsed = list.style.maxHeight === '0px' || list.style.maxHeight === '0rem' || list.style.maxHeight === '0';
    list.style.maxHeight = collapsed ? '20rem' : '0px';
    // 箭头方向与面板状态对应：展开(下拉)时朝上，折叠(上拉)时朝下
    chevron?.classList.toggle('rotate-180', collapsed);
    toggle.setAttribute('aria-expanded', String(collapsed));
  });
}
document.addEventListener('astro:page-load', initCategoryAccordion);
</script>
<script>
function initLanguageMenu() {
  const languageButton = document.getElementById('language-button');
  const languageMenu = document.getElementById('language-menu');
  const mobileMenu = document.getElementById('mobile-menu'); // 添加移动端菜单引用

  if (!languageButton || languageButton.dataset.bound === 'true') return;
  languageButton.dataset.bound = 'true';

  languageButton.addEventListener('click', (e) => {
    e.stopPropagation();
    mobileMenu?.classList.add('hidden');
    languageMenu?.classList.toggle('hidden');
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (
      target instanceof Node &&
      languageButton &&
      languageMenu &&
      !languageButton.contains(target) &&
      !languageMenu.contains(target)
    ) {
      languageMenu.classList.add('hidden');
    }
  });
}
document.addEventListener('astro:page-load', initLanguageMenu);
document.addEventListener('astro:after-swap', initLanguageMenu);
</script>

<script>
  function initHeaderScroll() {
    const header = document.getElementById('main-header');
    if (!header) return;

    let lastScrollY = window.scrollY;
    let ticking = false;

    function updateHeader() {
      const currentScrollY = window.scrollY;
      const scrollDelta = currentScrollY - lastScrollY;

      if (window.innerWidth < 776) {
        if (currentScrollY <= 50) {
          header?.classList.remove('header-hidden');
        } 
        else if (scrollDelta > 0 && currentScrollY > 100) {
          header?.classList.add('header-hidden');
        } 
        else if (scrollDelta < 0) {
          header?.classList.remove('header-hidden');
        }
      } else {
        header?.classList.remove('header-hidden');
      }
      lastScrollY = currentScrollY;
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        window.requestAnimationFrame(updateHeader);
        ticking = true;
      }
    }

    window.removeEventListener('scroll', onScroll);
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  document.addEventListener('astro:page-load', initHeaderScroll);
</script>


{import.meta.env.PROD && 
<script is:inline define:vars={{ scriptUrl: baseUrl('/pagefind/pagefind.js') }}>
async function loadAndSearch() {
  // 1. 如果已经加载过了，直接返回
  if (window.pagefind && typeof window.pagefind.search === 'function') {
    return;
  }
  
  if (window.pagefindLoading) return;
  window.pagefindLoading = true;

  try {
    // 动态导入脚本
    const pagefind = await import(scriptUrl);
    await pagefind.options({ excerptLength: 20 });
    window.pagefind = pagefind;
    
    // 触发自定义事件，通知搜索组件：Pagefind 准备好了
    document.dispatchEvent(new CustomEvent('pagefind-ready'));
  } catch (error) {
    console.error('Pagefind 加载失败:', error);
  } finally {
    window.pagefindLoading = false;
  }
}

// 2. 绑定到搜索按钮
function attachSearchListener() {
  const btn = document.getElementById('search-button');
  if (btn) {
    btn.addEventListener('click', loadAndSearch, { once: true });
  }
}

// 兼容 Astro 的 View Transitions
document.addEventListener('astro:page-load', attachSearchListener);
</script>
}
